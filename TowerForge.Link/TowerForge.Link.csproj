<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TowerForge Link — a small Windows helper that reads The Tower's data export
    (tool_export.json) off an Android emulator through the emulator's own adb,
    and hands it to towerforge.net running in the same PC's browser.
    Published as one self-contained exe by deploy.ps1 into the site's
    downloads/ folder (see docs/towerforge-link.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TowerForgeLink</AssemblyName>
    <RootNamespace>TowerForge.Link</RootNamespace>
    <Version>0.3.0</Version>
    <Product>TowerForge Link</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
